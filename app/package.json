{
  "name": "mqtt-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "docs:init": "git -C .. submodule update --init --recursive docs/shared",
    "docs:update": "git -C .. submodule update --remote --recursive docs/shared",
    "docs:status": "git -C .. submodule status docs/shared"
  },
  "dependencies": {
    "mqtt": "^5.15.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
